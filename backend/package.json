    "seed": "tsx src/scripts/seed.ts",
    "simulate": "tsx src/scripts/simulate.ts",
    "backfill:station": "tsx src/scripts/backfill-station.ts",
    "seed:units": "tsx src/scripts/seed-units.ts",
    "export:data": "tsx src/scripts/export-data.ts",
    "import:data": "tsx src/scripts/import-data.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bson": "^7.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "mongoose": "^9.2.1",
    "rate-limiter-flexible": "^9.1.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.21.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
