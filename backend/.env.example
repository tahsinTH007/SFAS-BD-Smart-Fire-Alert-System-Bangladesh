# ─────────────────────────────────────────────────────────────────────────────
# OGNIBORMO / SFAS-BD — backend configuration
# Copy to .env and fill in. Every value below has a working default except
# MONGO_URI, so a minimal .env only needs that one line.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
APP_NAME=SFAS-BD
BASE_URL=http://localhost:8080
LOG_LEVEL=debug

# ── Database (required) ──────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=smartFireAlertSystem

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Powers response caching and rate limiting. If unreachable the API still works:
# caching is skipped and rate limiting falls back to per-process memory.
# Leave username/password empty for a local Redis with no auth.
# REDIS_ENABLED=false skips the connection entirely — use it on a host with no
# Redis (e.g. the Render free tier) so the log is not full of retry warnings.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── Serial link to the sensing unit (optional) ───────────────────────────────
# Windows: COM3, COM7 …   Linux/macOS: /dev/ttyUSB0, /dev/tty.usbserial-0001
# Find it with:  arduino-cli board list
# Set SERIAL_ENABLED=false to run the API with no board attached.
#
# The ESP32 firmware in firmware/ognibormo_esp32/ runs at 115200 and emits JSON.
# The older Arduino prototype ran at 9600 — the two must match or nothing parses.
SERIAL_ENABLED=true
SERIAL_PORT=COM7
SERIAL_BAUD_RATE=115200
SERIAL_RETRY_INTERVAL=5000
SERIAL_DATA_FORMAT=json

# ── Built-in device simulator (hosted demos) ─────────────────────────────────
# Runs a few synthetic OGNIBORMO units inside the API process and feeds them
# through the real ingest pipeline — risk fusion, alert de-duplication, socket
# push, reading history and device online status are all the real thing. Use
# it where no board can be attached (Render, Railway, a laptop with no unit).
#
# Each unit is a small state machine with its own room baseline: mostly quiet,
# with the occasional cooking-smoke false alarm (no alert), smoulder
# (Important, sometimes escalating to a Critical fire), gas leak (Important)
# or fire (Critical). Values scale with the thresholds below, so the scenarios
# classify the same way whatever calibration is in force.
#
# Units default to the first DEVICE_SIMULATOR_COUNT active devices of the
# best-covered station (the one a fresh console opens on). Name specific units
# with DEVICE_SIMULATOR_DEVICES=OGB-UTT-001,OGB-UTT-002 instead.
DEVICE_SIMULATOR=false
DEVICE_SIMULATOR_COUNT=4
DEVICE_SIMULATOR_INTERVAL_MS=3000
# DEVICE_SIMULATOR_DEVICES=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Honoured in every environment. In development any
# localhost port is additionally allowed. One wildcard label per entry is
# supported, e.g. https://*.vercel.app for Vercel preview deployments.
# Hosted: CORS_ALLOWED_ORIGINS=https://sfas-bd.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,Accept

# ── Socket.IO ────────────────────────────────────────────────────────────────
# Hosted: set SOCKET_CORS_ORIGIN to the Vercel URL as well.
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# ── Multi-sensor alert thresholds ────────────────────────────────────────────
# These feed the risk engine in src/modules/sensors/riskEngine.ts.
# A reading crosses into "contributes to risk" at the threshold and reaches full
# weight above it. Alerts are raised at a fused score of 40+.
#
# SMOKE_THRESHOLD must be calibrated to your own MQ-2 — it has no absolute
# scale, and the ESP32's 12-bit ADC (0-4095) reads roughly 4x the Arduino's
# 10-bit one, so the old 80 fires constant false alerts on an ESP32.
# The firmware prints the right value on boot; the rule is:
#     SMOKE_THRESHOLD = (clean-air baseline + 250) / 2
# which lines the dashboard alert up with the unit's own siren.
SMOKE_THRESHOLD=192
GAS_THRESHOLD=300
TEMP_THRESHOLD=50
# Minimum gap between repeat alerts from the same device in the same state.
ALERT_DEDUPE_WINDOW_MS=60000
MAX_ALERT_HISTORY=1000
EVENT_BUS_RETRY=3

# ── Clerk auth (not wired up yet — safe to leave blank) ──────────────────────
CLERK_API_KEY=
CLERK_API_VERSION=latest
CLERK_FRONTEND_API=
CLERK_JWT_KEY=

# ── Notification providers (all optional) ────────────────────────────────────
NOTIF_EMAIL_PROVIDER=
NOTIF_EMAIL_API_KEY=
NOTIF_SMS_PROVIDER=
NOTIF_SMS_SID=
NOTIF_SMS_AUTH_TOKEN=
NOTIF_PUSH_PROVIDER=
NOTIF_PUSH_KEY_PATH=
