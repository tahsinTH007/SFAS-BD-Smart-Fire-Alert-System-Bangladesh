# Copy to .env.local — but on a normal setup you do not need to.
#
# Only NEXT_PUBLIC_-prefixed vars reach the browser. With the two URLs below
# left unset, src/lib/config.ts points the API and the socket at the same host
# the page was served from. That means opening the console at
# http://<PC-LAN-IP>:3000 from a phone or a second laptop just works, and keeps
# working when the WiFi changes and the LAN IP with it.
#
# Pinning localhost here breaks that: a phone would then look for the API on
# itself. Only set these when the API genuinely lives on a different host.
#
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# Port the backend listens on. Must match PORT in backend/.env.
NEXT_PUBLIC_API_PORT=8080

# ── Hosted (Vercel) ──────────────────────────────────────────────────────────
# On Vercel the API lives on another host, so both URLs must be set — in the
# Vercel project's Environment Variables, not in a file. They are baked in at
# build time, so redeploy after changing them.
#
# NEXT_PUBLIC_API_BASE_URL=https://sfas-bd-api.onrender.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=https://sfas-bd-api.onrender.com
